<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <VBox spacing="15.0" prefWidth="380.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8;">
            <children>
                <Label text="Formulario del Docente" textFill="#1a237e">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Separator />

                <VBox spacing="5.0">
                    <children>
                        <Label text="Documento de Identidad (DNI):" textFill="#34495e" />
                        <TextField fx:id="txtDniDocente" promptText="Ingrese 8 dígitos" prefHeight="30.0" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Nombres y Apellidos Completos:" textFill="#34495e" />
                        <TextField fx:id="txtNombreDocente" promptText="Ej: Carlos Mendoza" prefHeight="30.0" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Especialidad / Curso a cargo:" textFill="#34495e" />
                        <TextField fx:id="txtEspecialidad" promptText="Ej: Matemática, Historia" prefHeight="30.0" />
                    </children>
                </VBox>

                <Separator opacity="0.5" />
                <Label text="🔑 Credenciales de Acceso al Sistema" textFill="#5c6bc0">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Nombre de Usuario:" textFill="#34495e" />
                        <TextField fx:id="txtUsuarioDocente" promptText="Ej: cmendoza" prefHeight="30.0" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Contraseña del Sistema:" textFill="#34495e" />
                        <PasswordField fx:id="txtPasswordDocente" promptText="******" prefHeight="30.0" />
                    </children>
                </VBox>

                <Region prefHeight="10.0" VBox.vgrow="ALWAYS" />
                <Separator />

                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="35.0" />
                        <RowConstraints minHeight="35.0" />
                    </rowConstraints>
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" text="💾 Guardar" prefWidth="200.0" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" text="🔄 Actualizar" prefWidth="200.0" style="-fx-background-color: #0288d1; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" text="🧹 Limpiar" prefWidth="200.0" style="-fx-background-color: #78909c; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" text="❌ Eliminar" prefWidth="200.0" style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
            </children>
        </VBox>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <Label text="👨‍🏫 Panel de Docentes Registrados" textFill="#1a237e">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Separator />

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtBuscarDocente" promptText="Buscar por DNI, Nombre o Curso..." HBox.hgrow="ALWAYS" prefHeight="35.0" />
                        <Button text="🔍 Buscar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <TableView fx:id="tblDocentes" VBox.vgrow="ALWAYS" style="-fx-border-color: #e0e0e0;">
                    <columns>
                        <TableColumn fx:id="colDni" text="DNI" prefWidth="90.0" />
                        <TableColumn fx:id="colNombre" text="Docente / Profesor" prefWidth="180.0" />
                        <TableColumn fx:id="colEspecialidad" text="Especialidad" prefWidth="120.0" />
                        <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>

    </children>
</HBox>