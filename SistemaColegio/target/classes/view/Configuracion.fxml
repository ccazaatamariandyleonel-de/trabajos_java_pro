<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.controller.GestionConfiguracionController">
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Configuración del Sistema" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label text="Gestione los datos generales de la institución y seguridad." style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
            </children>
        </VBox>

        <GridPane hgap="15.0" vgap="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <children>

                <Label text="Nombre de la Institución:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtInstitucion" prefWidth="350.0" promptText="Ej. Institución Educativa UPeU" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Año Escolar Activo:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbAnioEscolar" prefWidth="150.0" promptText="Seleccionar" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Nueva Contraseña:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <PasswordField fx:id="txtPassword" prefWidth="200.0" promptText="Ingrese nueva clave" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" prefWidth="200.0">
            <children>
                <Button fx:id="btnGuardarConfig" mnemonicParsing="false" onAction="#handleGuardarConfig" style="-fx-background-color: #2ec4b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" text="💾 Guardar Cambios" />
            </children>
        </HBox>

    </children>
</VBox>