<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="panelReporte" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.controller.ReporteMatriculadosController"
      style="-fx-background-color: white; -fx-font-family: 'Segoe UI', Arial, sans-serif;"
      spacing="20" prefWidth="750" prefHeight="850">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox alignment="CENTER" prefWidth="120" prefHeight="130" style="-fx-background-color: #d8d8f6; -fx-background-radius: 10;">
            <Label text="🌀" style="-fx-font-size: 45px; -fx-text-fill: #1a1a8c;"/>
            <Label text="SISTEMA" style="-fx-font-weight: bold; -fx-text-fill: #1a1a8c; -fx-font-size: 13px;"/>
            <Label text="ACADÉMICO" style="-fx-font-weight: bold; -fx-text-fill: #1a1a8c; -fx-font-size: 13px;"/>
        </VBox>

        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="REPORTE OFICIAL DE" style="-fx-font-size: 22px; -fx-text-fill: #1a1a8c;"/>
            <Label text="ALUMNOS MATRICULADOS" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #0d0d59;"/>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                <Label fx:id="lblFecha" text="Fecha: Cargando..."
                       style="-fx-background-color: #e6e6fa; -fx-padding: 6 20 6 20; -fx-background-radius: 15; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a8c;"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
        <Label text="Resumen general" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #0d0d59;"/>
        <Label text="El proceso de matrícula se desarrolló de forma regular, fortaleciendo la base estudiantil de la institución y asegurando la participación activa para el presente ciclo."
               wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #555; -fx-line-spacing: 0.2em;"/>
    </VBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <VBox alignment="CENTER" prefWidth="130" prefHeight="80" style="-fx-background-color: #fff5e6; -fx-background-radius: 8;">
            <Label text="Métricas" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0d0d59;"/>
            <Label text="Claves" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0d0d59;"/>
        </VBox>

        <HBox spacing="25" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;">
            <VBox alignment="CENTER_LEFT">
                <Label text="👥 Alumnos totales" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                <Label fx:id="lblTotalAlumnos" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a1a8c;"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <VBox alignment="CENTER_LEFT">
                <Label text="📈 Nuevos Ingresos" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                <Label fx:id="lblNuevosIngresos" text="+0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a1a8c;"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <VBox alignment="CENTER_LEFT">
                <Label text="🎯 Tasa Retención" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                <Label fx:id="lblTasaRetencion" text="0%" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a1a8c;"/>
            </VBox>
        </HBox>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-padding: 10 0 0 0;">
        <Label text="Registro de Estudiantes" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #0d0d59;"/>

        <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS"
                   style="-fx-font-size: 13px; -fx-border-color: #d8d8f6; -fx-border-radius: 5; -fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="dni" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colNombre" text="NOMBRES" prefWidth="270">
                    <cellValueFactory><PropertyValueFactory property="nombre" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colApellido" text="APELLIDOS" prefWidth="270">
                    <cellValueFactory><PropertyValueFactory property="apellido" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>

    <HBox style="-fx-background-color: #e6e6fa; -fx-padding: 20; -fx-background-radius: 10;" alignment="CENTER_LEFT" spacing="20">
        <Label text="💡" style="-fx-font-size: 35px;"/>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Insight clave" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0d0d59;"/>
            <Label text="El registro indica un aumento orgánico en la matrícula de este año. Mantener el seguimiento académico será vital para el éxito."
                   wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #444;"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnImprimir" text="🖨️ Descargar PDF Oficial"
                style="-fx-background-color: #1a1a8c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"
                onAction="#imprimirPDF"/>
    </HBox>
</VBox>